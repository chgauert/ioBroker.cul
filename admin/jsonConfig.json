{
  "i18n": true,
  "type": "panel",
  "items": {
    "serialport": {
      "type": "autocompleteSendTo",
      "label": "Serial port",
      "command": "listUart5",
      "jsonData": "{\"experimental\":${data.experimental}}",
      "alsoDependsOn": ["experimental"],
      "sm": 10,
      "md": 6,
      "lg": 4
    },
    "baudrate": {
      "type": "select",
      "label": "Baud rate",
      "noTranslation": true,
      "sm": 2,
      "md": 2,
      "lg": 1,
      "options": [
        {"value": 110, "label":"110"},
        {"value": 150, "label":"150"},
        {"value": 300, "label":"300"},
        {"value": 600, "label":"600"},
        {"value": 1200, "label":"1200"},
        {"value": 2400, "label":"2400"},
        {"value": 4800, "label":"4800"},
        {"value": 9600, "label":"9600"},
        {"value": 19200, "label":"19200"},
        {"value": 38400, "label":"38400"},
        {"value": 56000, "label":"56000"},
        {"value": 57600, "label":"57600"},
        {"value": 115200, "label":"115200"}
      ]
    },
    "mode": {
      "newLine": true,
      "type": "select",
      "label": "Mode",
      "noTranslation": true,
      "sm": 10,
      "md": 6,
      "lg": 4,
      "options": [
        {"value": "SlowRF", "label":"SlowRF - (FS20, HMS, FHT, EM, ESA, IT, ...)"},
        {"value": "MORITZ", "label":"MORITZ - (MAX! devices)"},
        {"value": "AskSin", "label":"AskSin - (HomeMatic devices)"}
      ]
    },
    "type": {
      "type": "select",
      "noTranslation": true,
      "label": "Type",
      "attr":"type",
      "sm": 2,
      "md": 2,
      "lg": 1,
      "options": [
        {"value": "cul", "label":"CUL"},
        {"value": "stackedcul", "label":"Stacked CUL"},
        {"value": "coc", "label":"COC"},
        {"value": "scc", "label":"SCC"},
        {"value": "cuno", "label":"CUNO"}
      ]
    },
    "sc1Name": {
      "newLine": true,
      "type": "text",
      "noTranslation": true,
      "label": "Name Transmitter 1",
      "hidden" : "data.type != 'stackedcul'",
      "sm": 10,
      "md": 6,
      "lg": 4
    },
    "sc2Name": {
      "newLine": true,
      "type": "text",
      "noTranslation": true,
      "label": "Name Transmitter 2",
      "hidden" : "data.type != 'stackedcul'",
      "sm": 10,
      "md": 6,
      "lg": 4
    }, 
    "sc3Name": {
      "newLine": true,
      "type": "text",
      "noTranslation": true,
      "label": "Name Transmitter 3",
      "hidden" : "data.type != 'stackedcul'",
      "sm": 10,
      "md": 6,
      "lg": 4
    }, 
    "sc4Name": {
      "newLine": true,
      "type": "text",
      "noTranslation": true,
      "label": "Name Transmitter 4",
      "hidden" : "data.type != 'stackedcul'",
      "sm": 10,
      "md": 6,
      "lg": 4
    },             
    "ip": {
      "newLine": true,
      "type": "text",
      "label": "IP/Hostname",
      "sm": 10,
      "md": 6,
      "lg": 4
    },
    "port": {
      "type": "number",
      "label": "Port",
      "sm": 2,
      "md": 2,
      "lg": 1,
      "min": 1,
      "max": 65535
    },
    "experimental": {
      "newLine": true,
      "type": "checkbox",
      "label": "Experimental",
      "sm": 12
    },
    "autoadd": {
      "newLine": true,
      "type": "checkbox",
      "label": "Automatically add devices",
      "sm": 12
    }    
  }
}